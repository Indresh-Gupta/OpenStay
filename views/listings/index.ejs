<%- layout("layouts/boilerplate") %>

<body>
    <h3>All Listings</h3>
    <!-- <form method="GET" action="/listings/new">
      <button>Create New Listing</button>
    </form> -->
    
    <div class="row row-cols-lg-3 row-cols-lg-2 row-cols-lg-1 mt-3"> 
      <% for(let listing of allListings) { %>
          <a href="/listings/<%= listing._id %>" class="listing-link">
          <div class="card col listing-card">
              <% if (listing.image && listing.image.length > 0 && listing.image[0].url) { %>
    <img src="<%= listing.image[0].url %>" class="card-img-top" alt="listing_image" style="height:20rem"/>
<% } else { %>
    <img src="https://via.placeholder.com/300x200?text=No+Image" class="card-img-top" alt="default_image" style="height:20rem"/>
<% } %>

              <div class="card-img-overlay"></div>
              <div class="card-body">
               <p class="card-text"> 
                  <br/>
                 <b><%= listing.title %></b>
               <br/>
               &#8377; <%= listing.price.toLocaleString("en-IN") %>/night
               <i class="tax-info"> &nbsp; &nbsp; +18% GST</i>
               </p>
              </div>
            </div>
          </a>
           <% } %>
  </div>
  
   
  </body>
